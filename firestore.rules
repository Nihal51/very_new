rules_version = '2';

// =============================================================================
//  DriveBuddy — Firestore security rules
// =============================================================================
//  The website is a static site with no server of its own, so browsers talk to
//  Firestore directly. These rules are what keep customers' names, numbers and
//  addresses private. Publish: Firebase console → Firestore → Rules → paste →
//  Publish (or `npm run deploy:backend`).
//
//  WHO CAN DO WHAT
//
//    Anyone (no login)    create a booking or a driver application, in the exact
//                         shape the website forms produce. Nothing else.
//    A logged-in customer the above, plus: read and edit their own profile
//                         (users/{uid}), register their phones for booking
//                         notifications (users/{uid}/devices), and read the
//                         bookings they made while logged in. Never anyone else's.
//    An admin             read everything; move bookings and drivers through
//                         their statuses; assign drivers; add notes; save the
//                         price agreed on the call. An admin is
//                         a Google account with a verified email that has a
//                         document in admins/{email}. Only the alerts robot
//                         (apps-script/Code.js, from its ADMIN_EMAILS property)
//                         or the Firebase console can create one — no email
//                         address is written in this file.
//    The alerts robot     everything else (reference numbers, customer records,
//                         alerts). It calls Firestore as the project owner's
//                         Google account, which these rules do not apply to, so
//                         no browser can forge those fields.
//
//  Nothing is ever deleted from the browser — a booking is cancelled, not erased,
//  so the history of every job stays complete.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------------------------------------- helpers -- */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        // .get() with defaults: phone-login customers have no email at all.
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.get('email', '').lower()));
    }

    function isText(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isOptionalText(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    // Indian mobile: exactly ten digits, starting 6–9. Forms strip +91 / 0 first.
    function isMobile(value) {
      return value is string && value.matches('^[6-9][0-9]{9}$');
    }

    function isServedCity(value) {
      return value in ['Raipur', 'Bhilai', 'Durg', 'Bilaspur'];
    }

    // Numbers an admin blocked from /admin (spam, abuse): no new bookings or
    // driver applications with them, from the website or the app.
    function isBlocked(phone) {
      return exists(/databases/$(database)/documents/blocked/$(phone));
    }

    // Clients cannot backdate a submission, invent a source, or create a lead
    // that is already marked as handled. 'app' = the DriveBuddy mobile app
    // (Nihal51/drivebuddy-mobile), which writes exactly the website's shape.
    function isServerStamped(data) {
      return data.createdAt == request.time
        && data.source in ['website', 'app']
        && data.status == 'new';
    }

    // Every admin edit records who made it (uid — customers can read their own
    // booking, so no admin email is stored on it) and when (server time).
    function isAdminStamped(data) {
      return data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /* ---------------------------------------------------------- bookings -- */
    //  Created by components/BookingForm.tsx; numbered and alerted by the
    //  alerts robot (apps-script/Code.js); managed in /admin.

    function bookingStatuses() {
      return ['new', 'confirmed', 'assigned', 'completed', 'cancelled'];
    }

    function isDriverRef(d) {
      return d is map
        && d.keys().hasOnly(['id', 'name', 'phone'])
        && d.keys().hasAll(['id', 'name', 'phone'])
        && isText(d.id, 1, 128)
        && isText(d.name, 2, 60)
        && isMobile(d.phone);
    }

    // The trip on an outstation booking ('round': the driver stays with the
    // customer and drives back) or a one-way drop (the driver comes home by
    // bus/train). Written by the booking form from lib/outstation.ts; the
    // estimate is only what the customer was shown — the team quotes on the
    // call. destId '' = a place not in our list (km and estimate 0).
    function isTrip(t, pkg) {
      return t is map
        && t.keys().hasOnly(['to', 'destId', 'kind', 'km', 'days', 'returnHours', 'estFrom', 'estTo'])
        && t.keys().hasAll(['to', 'destId', 'kind', 'km', 'days', 'returnHours', 'estFrom', 'estTo'])
        && isText(t.to, 2, 60)
        && t.destId is string && t.destId.matches('^[a-z]{0,30}$')
        && ((pkg == 'outstation' && t.kind == 'round') || (pkg == 'one-way-drop' && t.kind == 'one-way'))
        && t.km is int && t.km >= 0 && t.km <= 5000
        && t.days is int && t.days >= 1 && t.days <= 60
        // One-way: hours from the drop until the driver is home (his way home).
        && t.returnHours is int && t.returnHours >= 0 && t.returnHours <= 200
        && (t.kind == 'one-way' || t.returnHours == 0)
        && t.estFrom is int && t.estFrom >= 0 && t.estFrom <= 1000000
        && t.estTo is int && t.estTo >= t.estFrom && t.estTo <= 1000000;
    }

    // The price the team agreed with the customer on the call, from the quote
    // calculator in /admin. The customer can read it (their booking), so it
    // holds only what they pay — the driver's cost and the profit go in the
    // admin-only timeline, never here.
    function isQuote(q) {
      return q is map
        && q.keys().hasOnly(['amount', 'dayRate', 'days', 'returnHours', 'returnHourRate', 'returnCharge', 'extraHours', 'extraHourRate', 'extraCharge', 'ticket', 'at'])
        && q.keys().hasAll(['amount', 'dayRate', 'days', 'returnHours', 'returnHourRate', 'returnCharge', 'extraHours', 'extraHourRate', 'ticket', 'at'])
        && q.amount is int && q.amount > 0 && q.amount <= 1000000
        && q.dayRate is int && q.dayRate > 0 && q.dayRate <= 100000
        // Full days at the day rate; 0 for a drive shorter than a day, priced by the hour.
        && q.days is int && q.days >= 0 && q.days <= 60 && (q.days >= 1 || q.extraHours >= 1)
        && q.returnHours is int && q.returnHours >= 0 && q.returnHours <= 200
        && q.returnHourRate is int && q.returnHourRate >= 0 && q.returnHourRate <= 10000
        // The way home: each 24 h a day (10 hours' worth), the hours left over by
        // the hour or — more than 6 — one more day. Never more than that.
        && q.returnCharge is int && q.returnCharge >= 0
        && q.returnCharge <= q.returnHourRate * 10 * (q.returnHours / 24 + 1)
        && q.extraHours is int && q.extraHours >= 0 && q.extraHours <= 200
        && q.extraHourRate is int && q.extraHourRate >= 0 && q.extraHourRate <= 10000
        // The extra hours' charge (newer quotes): hours × rate, or — a one-way
        // drive shorter than a day — the short-drive price (₹600 for 3 h, …),
        // never more than a day. Older quotes leave it out: hours × rate.
        && (!('extraCharge' in q) || (q.extraCharge is int && q.extraCharge >= 0
              && (q.extraCharge <= q.extraHourRate * q.extraHours || (q.days == 0 && q.extraCharge <= q.dayRate))))
        && q.ticket is int && q.ticket >= 0 && q.ticket <= 100000
        && q.amount == q.dayRate * q.days + q.returnCharge + q.get('extraCharge', q.extraHourRate * q.extraHours) + q.ticket
        && q.at == request.time;
    }

    // A time on a trip, if it is there at all (never null).
    function isOptTime(m, k) {
      return !(k in m) || m[k] is timestamp;
    }

    function inOrder(m, a, b) {
      return !(a in m) || !(b in m) || m[a] <= m[b];
    }

    // The real times of the trip, copied from the driver's trip link by the
    // alerts robot (and by /admin with the final bill), so the customer sees
    // when he started, dropped the car and got home.
    function isClock(c) {
      return c is map
        && c.keys().hasOnly(['startAt', 'dropAt', 'homeAt'])
        && isOptTime(c, 'startAt') && isOptTime(c, 'dropAt') && isOptTime(c, 'homeAt')
        && inOrder(c, 'startAt', 'dropAt') && inOrder(c, 'dropAt', 'homeAt') && inOrder(c, 'startAt', 'homeAt');
    }

    // The final bill from the real times (lib/outstation.ts finalBill), saved
    // from /admin. Like the quote it holds only what the customer pays; the
    // driver's pay and the profit go in the admin-only timeline.
    function isBill(b) {
      return b is map
        && b.keys().hasOnly(['amount', 'dayRate', 'days', 'extraHours', 'extraHourRate', 'extraCharge', 'returnHours', 'returnHourRate', 'returnCharge', 'ticket', 'nonstop', 'at'])
        && b.keys().hasAll(['amount', 'dayRate', 'days', 'extraHours', 'extraHourRate', 'extraCharge', 'returnHours', 'returnHourRate', 'returnCharge', 'ticket', 'nonstop', 'at'])
        && b.amount is int && b.amount > 0 && b.amount <= 1000000
        && b.dayRate is int && b.dayRate > 0 && b.dayRate <= 100000
        && b.days is int && b.days >= 0 && b.days <= 60 && (b.days >= 1 || b.extraHours >= 1)
        && b.extraHours is int && b.extraHours >= 0 && b.extraHours <= 200
        && b.extraHourRate is int && b.extraHourRate >= 0 && b.extraHourRate <= 10000
        // Never more than hours × rate — except a one-way drive shorter than a
        // day, priced in steps (₹600 for 3 h, …) — and never more than one day.
        && b.extraCharge is int && b.extraCharge >= 0
        && (b.extraCharge <= b.extraHourRate * b.extraHours || b.days == 0) && b.extraCharge <= b.dayRate
        && b.returnHours is int && b.returnHours >= 0 && b.returnHours <= 400
        && b.returnHourRate is int && b.returnHourRate >= 0 && b.returnHourRate <= 10000
        && b.returnCharge is int && b.returnCharge >= 0
        && b.returnCharge <= b.returnHourRate * 10 * (b.returnHours / 24 + 1)
        && b.ticket is int && b.ticket >= 0 && b.ticket <= 100000
        && b.nonstop is bool
        && b.amount == b.dayRate * b.days + b.extraCharge + b.returnCharge + b.ticket
        && b.at == request.time;
    }

    match /bookings/{bookingId} {
      // Admins see everything; a customer sees only bookings tied to their login.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('customerUid', '') == request.auth.uid);

      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'city', 'package', 'pickup',
          'preferredTime', 'notes', 'createdAt', 'status', 'source',
          'customerUid', 'trip'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'city', 'package', 'pickup',
          'preferredTime', 'notes', 'createdAt', 'status', 'source'
        ])
        && isText(request.resource.data.name, 2, 60)
        && isMobile(request.resource.data.phone)
        && isServedCity(request.resource.data.city)
        && request.resource.data.package in [
          '1-hour-300',
          '3-hours-600',
          'local-full-day',
          'outstation',
          'night-driver',
          'medical-emergency',
          'monthly-basic',
          'monthly-premium',
          'wedding-event',
          'one-way-drop'
        ]
        && isText(request.resource.data.pickup, 6, 300)
        && isOptionalText(request.resource.data.preferredTime, 40)
        && isOptionalText(request.resource.data.notes, 500)
        // Guests leave customerUid out; a logged-in customer can only tag their own uid.
        && (!('customerUid' in request.resource.data)
            || (isSignedIn() && request.resource.data.customerUid == request.auth.uid))
        // Only outstation trips and one-way drops carry a trip; it is optional
        // (older app versions leave it out).
        && (!('trip' in request.resource.data)
            || isTrip(request.resource.data.trip, request.resource.data.package))
        && !isBlocked(request.resource.data.phone)
        && isServerStamped(request.resource.data);

      // Admins move a booking through its lifecycle. The customer's own details
      // and everything the server wrote stay read-only, even to an admin.
      // Internal notes do NOT live here — the customer can read this document —
      // they go in the admin-only timeline below.
      allow update: if isAdmin()
        && changedOnly(['status', 'assignedDriver', 'cancelReason', 'quote', 'clock', 'bill', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in bookingStatuses()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['quote'])
            || request.resource.data.get('quote', null) == null
            || isQuote(request.resource.data.quote))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clock'])
            || request.resource.data.get('clock', null) == null
            || isClock(request.resource.data.clock))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bill'])
            || request.resource.data.get('bill', null) == null
            || isBill(request.resource.data.bill))
        && (request.resource.data.get('assignedDriver', null) == null
            || isDriverRef(request.resource.data.assignedDriver))
        && isOptionalText(request.resource.data.get('cancelReason', ''), 200)
        && isAdminStamped(request.resource.data);

      allow delete: if false;

      // The timeline: one entry per change or note, append-only, admins only.
      // Status changes are written in the same batch as the change itself; so
      // is a quote or a final bill, whose entry keeps the driver's pay and the
      // profit.
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'from', 'to', 'note', 'by', 'at'])
          && request.resource.data.keys().hasAll(['type', 'from', 'to', 'note', 'by', 'at'])
          && request.resource.data.type in ['status', 'driver', 'note', 'quote', 'bill']
          && (request.resource.data.from == null || request.resource.data.from in bookingStatuses())
          && (request.resource.data.to == null || request.resource.data.to in bookingStatuses())
          && isOptionalText(request.resource.data.note, 500)
          && request.resource.data.by == request.auth.token.email
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    /* -------------------------------------------------------- trip links -- */
    //  The driver's trip clock (lib/tripclock.ts, the page /trip/?k=…). An
    //  admin makes one for an outstation trip or one-way drop and sends the
    //  link to the driver on WhatsApp. He needs no login: the document id IS
    //  the key (24–40 random letters and digits), so only someone who was sent
    //  the link can open or tap it, and nobody can list them. Each tap sets the
    //  next time to the server's clock, once and in order: start → drop (the
    //  car handed over; one-way only) → home. The alerts robot copies the times
    //  to the booking (clock) and tells Telegram; /admin works out the final
    //  bill and can correct a time.

    function isLoc(l) {
      return l is map
        && l.keys().hasOnly(['lat', 'lng', 'acc'])
        && l.keys().hasAll(['lat', 'lng', 'acc'])
        && l.lat is number && l.lat >= -90 && l.lat <= 90
        && l.lng is number && l.lng >= -180 && l.lng <= 180
        && l.acc is number && l.acc >= 0 && l.acc <= 100000;
    }

    // One tap for `step` ('start', 'drop' or 'home'): the server's time; the
    // phone's own clock (it may have been offline: at most a day earlier,
    // never more than 10 minutes ahead); where he was, if he allowed it.
    function isTap(step) {
      let d = request.resource.data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([step + 'At', step + 'Phone', step + 'Loc', 'updatedAt'])
        && d[step + 'At'] == request.time
        && d[step + 'Phone'] is timestamp
        && d[step + 'Phone'] > request.time - duration.value(24, 'h')
        && d[step + 'Phone'] < request.time + duration.value(10, 'm')
        && (!((step + 'Loc') in d) || isLoc(d[step + 'Loc']))
        && d.updatedAt == request.time;
    }

    function isDriverTap() {
      let o = resource.data;
      return o.closed == false
        && ((!('startAt' in o) && isTap('start'))
          || (o.kind == 'one-way' && ('startAt' in o) && !('dropAt' in o) && isTap('drop'))
          || (('startAt' in o) && (o.kind == 'round' || ('dropAt' in o)) && !('homeAt' in o) && isTap('home')));
    }

    function tripLinkKeys() {
      return ['bookingId', 'ref', 'to', 'kind', 'nonstop', 'driverName', 'closed', 'createdAt', 'updatedAt', 'by'];
    }

    match /tripLinks/{key} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isAdmin()
        && key.matches('^[A-Za-z0-9]{24,40}$')
        && request.resource.data.keys().hasOnly(tripLinkKeys())
        && request.resource.data.keys().hasAll(tripLinkKeys())
        && isText(request.resource.data.bookingId, 1, 128)
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && isOptionalText(request.resource.data.ref, 20)
        && isText(request.resource.data.to, 2, 60)
        && request.resource.data.kind in ['one-way', 'round']
        && request.resource.data.nonstop is bool
        && isText(request.resource.data.driverName, 2, 60)
        && request.resource.data.closed == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.by == request.auth.uid;

      // An admin correcting the times (a time is removed, never set to
      // null), switching day-and-night driving, or closing the link once the
      // bill is saved; or the driver's tap.
      allow update: if (isAdmin()
          && changedOnly(['startAt', 'dropAt', 'homeAt', 'nonstop', 'closed', 'updatedAt', 'by'])
          && isOptTime(request.resource.data, 'startAt')
          && isOptTime(request.resource.data, 'dropAt')
          && isOptTime(request.resource.data, 'homeAt')
          && (request.resource.data.kind == 'one-way' || !('dropAt' in request.resource.data))
          && inOrder(request.resource.data, 'startAt', 'dropAt')
          && inOrder(request.resource.data, 'dropAt', 'homeAt')
          && inOrder(request.resource.data, 'startAt', 'homeAt')
          && request.resource.data.nonstop is bool
          && request.resource.data.closed is bool
          && request.resource.data.updatedAt == request.time
          && request.resource.data.by == request.auth.uid)
        || isDriverTap();

      allow delete: if false;
    }

    /* ----------------------------------------------------------- drivers -- */
    //  Applications from components/DriverForm.tsx; vetted in /admin.

    match /drivers/{driverId} {
      allow read: if isAdmin();

      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'city', 'experienceYears',
          'licence', 'about', 'createdAt', 'status', 'source'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'city', 'experienceYears',
          'licence', 'about', 'createdAt', 'status', 'source'
        ])
        && isText(request.resource.data.name, 2, 60)
        && isMobile(request.resource.data.phone)
        && isServedCity(request.resource.data.city)
        && request.resource.data.experienceYears is int
        && request.resource.data.experienceYears >= 5
        && request.resource.data.experienceYears <= 60
        && request.resource.data.licence in ['commercial', 'lmv', 'both']
        && isOptionalText(request.resource.data.about, 500)
        && !isBlocked(request.resource.data.phone)
        && isServerStamped(request.resource.data);

      // new → verified → active ⇄ inactive, or rejected.
      allow update: if isAdmin()
        && changedOnly(['status', 'adminNote', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'verified', 'active', 'inactive', 'rejected']
        && isOptionalText(request.resource.data.get('adminNote', ''), 1000)
        && isAdminStamped(request.resource.data);

      allow delete: if false;
    }

    /* ------------------------------------------------------------- users -- */
    //  A customer's own login profile, written from /account.

    match /users/{uid} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == uid;
      }
      function validProfile(data) {
        return isText(data.name, 2, 60)
          && (data.get('phone', '') == '' || isMobile(data.get('phone', '')))
          && (data.get('email', '') == '' || data.get('email', '') == request.auth.token.get('email', ''));
      }

      allow read: if isOwner() || isAdmin();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && changedOnly(['name', 'phone', 'email', 'updatedAt'])
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // "Delete my account" in the app (a Google Play and App Store requirement).
      // Their bookings stay, as business records (see /privacy).
      allow delete: if isOwner();

      // One per phone with booking notifications on, written by the mobile app:
      // the Expo push token and the language to write in. The alerts robot
      // reads these to send "Driver assigned" and other status updates. The
      // customer removes their phone on logout; the robot drops dead tokens.
      match /devices/{deviceId} {
        function validDevice(data) {
          return data.keys().hasOnly(['token', 'platform', 'language', 'updatedAt'])
            && data.keys().hasAll(['token', 'platform', 'language', 'updatedAt'])
            && data.token is string
            && data.token.matches('^Expo(nent)?PushToken\\[[A-Za-z0-9_-]{8,200}\\]$')
            && data.platform in ['android', 'ios']
            && data.language in ['en', 'hi']
            && data.updatedAt == request.time;
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && deviceId.size() <= 150 && validDevice(request.resource.data);
      }
    }

    /* --------------------------------------------------------- customers -- */
    //  One record per phone number, kept by the alerts robot: name, booking
    //  count, first and last booking. Read-only, admins only.

    match /customers/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ----------------------------------------------------------- blocked -- */
    //  blocked/{phone}: numbers that may not book or apply (spam, abuse).
    //  Added and removed by an admin from a booking in /admin. Never readable
    //  by customers, so a blocked number cannot tell why.

    match /blocked/{phone} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isMobile(phone)
        && request.resource.data.keys().hasOnly(['reason', 'by', 'at'])
        && request.resource.data.keys().hasAll(['reason', 'by', 'at'])
        && isOptionalText(request.resource.data.reason, 200)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    /* ------------------------------------------------------------ admins -- */
    //  admins/{email}: written by the alerts robot's setup() or by hand in the
    //  Firebase console. A signed-in user may check only their own entry —
    //  that is how /admin knows whether to show the dispatch desk.

    match /admins/{email} {
      allow read: if isSignedIn() && request.auth.token.get('email', '').lower() == email;
      allow write: if false;
    }

    /* -------------------------------------------------------- catch-all -- */
    //  Anything not allowed above is denied — including meta/counters and any
    //  collection someone invents.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
