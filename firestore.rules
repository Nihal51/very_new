rules_version = '2';

// =============================================================================
//  DriveBuddy — Firestore security rules
// =============================================================================
//  The website is a static site with no server of its own, so browsers talk to
//  Firestore directly. These rules are what keep customers' names, numbers and
//  addresses private. Publish: Firebase console → Firestore → Rules → paste →
//  Publish (or `npm run deploy:backend`).
//
//  WHO CAN DO WHAT
//
//    Anyone (no login)    create a booking or a driver application, in the exact
//                         shape the website forms produce. Nothing else.
//    A logged-in customer the above, plus: read and edit their own profile
//                         (users/{uid}), register their phones for booking
//                         notifications (users/{uid}/devices), and read the
//                         bookings they made while logged in. Never anyone else's.
//                         On their own trip they may accept the estimate once
//                         (acceptedPrice), and rate the driver once the job is
//                         completed (ratings/{bookingId}).
//    A driver             logged in to the DriveBuddy Driver app (a code by SMS;
//                         the alerts robot signs his login with role 'driver' and
//                         his number): read the bookings assigned to his number
//                         while they are "assigned", and share his live location
//                         on them (tracking/{bookingId}); an Active driver also
//                         sees the open job offers in his city (or offered to
//                         it from a nearby city), takes one (the booking is
//                         assigned to him), and sees his earnings. He taps
//                         Start / Arrived / Job done on his job (tripTaps), may
//                         give a job back before Start, and sets his UPI ID.
//                         Nothing else.
//    An admin             read everything; move bookings and drivers through
//                         their statuses; assign drivers; add notes; save the
//                         price agreed on the call. An admin is
//                         a Google account with a verified email that has a
//                         document in admins/{email}. Only the alerts robot
//                         (apps-script/Code.js, from its ADMIN_EMAILS property)
//                         or the Firebase console can create one — no email
//                         address is written in this file.
//    The alerts robot     everything else (reference numbers, customer records,
//                         alerts). It calls Firestore as the project owner's
//                         Google account, which these rules do not apply to, so
//                         no browser can forge those fields.
//
//  Nothing is ever deleted from the browser — a booking is cancelled, not erased,
//  so the history of every job stays complete.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------------------------------------- helpers -- */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        // .get() with defaults: phone-login customers have no email at all.
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.get('email', '').lower()));
    }

    // The Driver app's login: a custom token from the alerts robot
    // (apps-script/Code.js, "driver login"), only after an SMS code to a
    // number on a Verified or Active driver record.
    function isDriver() {
      return isSignedIn()
        && request.auth.token.get('role', '') == 'driver'
        && isMobile(request.auth.token.get('driverPhone', ''));
    }

    // The logged-in driver's own record in drivers/ (his login carries its id).
    function myDriver() {
      return get(/databases/$(database)/documents/drivers/$(request.auth.token.driverId)).data;
    }

    // An Active driver whose record really has the number his login says.
    function isActiveDriver() {
      return isDriver()
        && request.auth.token.get('driverId', '') is string
        && exists(/databases/$(database)/documents/drivers/$(request.auth.token.driverId))
        && myDriver().status == 'active'
        && myDriver().phone == request.auth.token.driverPhone;
    }

    // How he appears on a booking he takes: exactly his record.
    function meAsDriverRef() {
      return { 'id': request.auth.token.driverId, 'name': myDriver().name, 'phone': request.auth.token.driverPhone };
    }

    // A booking this driver is on right now: assigned to his number, and still
    // "assigned" (once it is completed or cancelled he no longer sees it).
    // Plain comparisons, so the app's query (assignedDriver.phone == his number,
    // status == 'assigned') can be checked against it; a booking without a
    // driver errors here, which counts as no.
    function isMyJob(b) {
      return b.status == 'assigned'
        && b.assignedDriver.phone == request.auth.token.driverPhone;
    }

    function isText(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isOptionalText(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    // Indian mobile: exactly ten digits, starting 6–9. Forms strip +91 / 0 first.
    function isMobile(value) {
      return value is string && value.matches('^[6-9][0-9]{9}$');
    }

    function isServedCity(value) {
      return value in ['Raipur', 'Bhilai', 'Durg', 'Bilaspur'];
    }

    // Numbers an admin blocked from /admin (spam, abuse): no new bookings or
    // driver applications with them, from the website or the app.
    function isBlocked(phone) {
      return exists(/databases/$(database)/documents/blocked/$(phone));
    }

    // Clients cannot backdate a submission, invent a source, or create a lead
    // that is already marked as handled. 'app' = the DriveBuddy mobile app
    // (Nihal51/drivebuddy-mobile), which writes exactly the website's shape.
    function isServerStamped(data) {
      return data.createdAt == request.time
        && data.source in ['website', 'app']
        && data.status == 'new';
    }

    // Every admin edit records who made it (uid — customers can read their own
    // booking, so no admin email is stored on it) and when (server time).
    function isAdminStamped(data) {
      return data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /* ---------------------------------------------------------- bookings -- */
    //  Created by components/BookingForm.tsx; numbered and alerted by the
    //  alerts robot (apps-script/Code.js); managed in /admin.

    function bookingStatuses() {
      return ['new', 'confirmed', 'assigned', 'completed', 'cancelled'];
    }

    function isDriverRef(d) {
      return d is map
        && d.keys().hasOnly(['id', 'name', 'phone'])
        && d.keys().hasAll(['id', 'name', 'phone'])
        && isText(d.id, 1, 128)
        && isText(d.name, 2, 60)
        && isMobile(d.phone);
    }

    // The trip on an outstation booking ('round': the driver stays with the
    // customer and drives back) or a one-way drop (the driver comes home by
    // bus/train). Written by the booking form from lib/outstation.ts; the
    // estimate is only what the customer was shown — the team quotes on the
    // call. destId '' = a place not in our list (km and estimate 0).
    function isTrip(t, pkg) {
      return t is map
        && t.keys().hasOnly(['to', 'destId', 'kind', 'km', 'days', 'returnHours', 'estFrom', 'estTo'])
        && t.keys().hasAll(['to', 'destId', 'kind', 'km', 'days', 'returnHours', 'estFrom', 'estTo'])
        && isText(t.to, 2, 60)
        && t.destId is string && t.destId.matches('^[a-z]{0,30}$')
        && ((pkg == 'outstation' && t.kind == 'round') || (pkg == 'one-way-drop' && t.kind == 'one-way'))
        && t.km is int && t.km >= 0 && t.km <= 5000
        && t.days is int && t.days >= 1 && t.days <= 60
        // One-way: hours from the drop until the driver is home (his way home).
        && t.returnHours is int && t.returnHours >= 0 && t.returnHours <= 200
        && (t.kind == 'one-way' || t.returnHours == 0)
        && t.estFrom is int && t.estFrom >= 0 && t.estFrom <= 1000000
        && t.estTo is int && t.estTo >= t.estFrom && t.estTo <= 1000000;
    }

    // The price the team agreed with the customer on the call, from the quote
    // calculator in /admin. The customer can read it (their booking), so it
    // holds only what they pay — the driver's cost and the profit go in the
    // admin-only timeline, never here.
    function isQuote(q) {
      return q is map
        && q.keys().hasOnly(['amount', 'dayRate', 'days', 'returnHours', 'returnHourRate', 'returnCharge', 'extraHours', 'extraHourRate', 'extraCharge', 'awayHours', 'km', 'ticket', 'at'])
        && q.keys().hasAll(['amount', 'dayRate', 'days', 'returnHours', 'returnHourRate', 'returnCharge', 'extraHours', 'extraHourRate', 'ticket', 'at'])
        && q.amount is int && q.amount > 0 && q.amount <= 1000000
        && q.dayRate is int && q.dayRate > 0 && q.dayRate <= 100000
        // Full days at the day rate; 0 for a drive shorter than a day, priced by the hour.
        && q.days is int && q.days >= 0 && q.days <= 60 && (q.days >= 1 || q.extraHours >= 1)
        && q.returnHours is int && q.returnHours >= 0 && q.returnHours <= 200
        && q.returnHourRate is int && q.returnHourRate >= 0 && q.returnHourRate <= 10000
        // The way home: each 24 h a day (10 hours' worth), the hours left over by
        // the hour or — more than 6 — one more day. Never more than that.
        && q.returnCharge is int && q.returnCharge >= 0
        && q.returnCharge <= q.returnHourRate * 10 * (q.returnHours / 24 + 1)
        && q.extraHours is int && q.extraHours >= 0 && q.extraHours <= 200
        && q.extraHourRate is int && q.extraHourRate >= 0 && q.extraHourRate <= 10000
        // The extra hours' charge (newer quotes): hours × rate, or — a one-way
        // drive shorter than a day — at least the short-drive minimum (₹600),
        // never more than a day. Older quotes leave it out: hours × rate.
        && (!('extraCharge' in q) || (q.extraCharge is int && q.extraCharge >= 0
              && (q.extraCharge <= q.extraHourRate * q.extraHours || (q.days == 0 && q.extraCharge <= q.dayRate))))
        && q.ticket is int && q.ticket >= 0 && q.ticket <= 100000
        // A route price (quotes from 1 Nov 2026): one day at the route price, nothing else but the ticket.
        && isRoute(q, 0)
        && q.amount == q.dayRate * q.days + q.returnCharge + q.get('extraCharge', q.extraHourRate * q.extraHours) + q.ticket
        && q.at == request.time;
    }

    // A route price on a quote or bill (from 1 Nov 2026): the hours away it is
    // for and the km; then days == 1 at dayRate = the route price, no way-home
    // charge, and extra hours only as the bill's hours late (`late`: 0 on a quote).
    function isRoute(m, late) {
      return (!('km' in m) || (m.km is int && m.km > 0 && m.km <= 10000))
        && (!('awayHours' in m) || (m.awayHours is int && m.awayHours >= 1 && m.awayHours <= 1000
              && m.days == 1 && m.returnCharge == 0 && m.extraHours <= late));
    }

    // A spot in India (lib/geo.ts): latitude, longitude and, from GPS, its accuracy in metres.
    function isGeo(g) {
      return g is map
        && g.keys().hasOnly(['lat', 'lng', 'acc'])
        && g.keys().hasAll(['lat', 'lng'])
        && g.lat is number && g.lat >= 6 && g.lat <= 37
        && g.lng is number && g.lng >= 68 && g.lng <= 98
        && (!('acc' in g) || (g.acc is number && g.acc >= 0 && g.acc <= 100000));
    }

    // A time on a trip, if it is there at all (never null).
    function isOptTime(m, k) {
      return !(k in m) || m[k] is timestamp;
    }

    function inOrder(m, a, b) {
      return !(a in m) || !(b in m) || m[a] <= m[b];
    }

    // The real times of the trip, copied from the driver's trip link by the
    // alerts robot (and by /admin with the final bill), so the customer sees
    // when he started, dropped the car and got home.
    function isClock(c) {
      return c is map
        && c.keys().hasOnly(['startAt', 'dropAt', 'homeAt'])
        && isOptTime(c, 'startAt') && isOptTime(c, 'dropAt') && isOptTime(c, 'homeAt')
        && inOrder(c, 'startAt', 'dropAt') && inOrder(c, 'dropAt', 'homeAt') && inOrder(c, 'startAt', 'homeAt');
    }

    // The final bill from the real times (lib/outstation.ts finalBill), saved
    // from /admin. Like the quote it holds only what the customer pays; the
    // driver's pay and the profit go in the admin-only timeline.
    function isBill(b) {
      return b is map
        && b.keys().hasOnly(['amount', 'dayRate', 'days', 'extraHours', 'extraHourRate', 'extraCharge', 'returnHours', 'returnHourRate', 'returnCharge', 'awayHours', 'km', 'ticket', 'nonstop', 'at'])
        && b.keys().hasAll(['amount', 'dayRate', 'days', 'extraHours', 'extraHourRate', 'extraCharge', 'returnHours', 'returnHourRate', 'returnCharge', 'ticket', 'nonstop', 'at'])
        && b.amount is int && b.amount > 0 && b.amount <= 1000000
        && b.dayRate is int && b.dayRate > 0 && b.dayRate <= 100000
        && b.days is int && b.days >= 0 && b.days <= 60 && (b.days >= 1 || b.extraHours >= 1)
        && b.extraHours is int && b.extraHours >= 0 && b.extraHours <= 200
        && b.extraHourRate is int && b.extraHourRate >= 0 && b.extraHourRate <= 10000
        // Never more than hours × rate — except a one-way drive shorter than a
        // day, which costs at least the minimum (₹600) — and never more than one day.
        && b.extraCharge is int && b.extraCharge >= 0
        && (b.extraCharge <= b.extraHourRate * b.extraHours || b.days == 0) && b.extraCharge <= b.dayRate
        && b.returnHours is int && b.returnHours >= 0 && b.returnHours <= 400
        && b.returnHourRate is int && b.returnHourRate >= 0 && b.returnHourRate <= 10000
        && b.returnCharge is int && b.returnCharge >= 0
        && b.returnCharge <= b.returnHourRate * 10 * (b.returnHours / 24 + 1)
        && b.ticket is int && b.ticket >= 0 && b.ticket <= 100000
        && b.nonstop is bool
        // A route price: one day at the price, the hours late at the hourly rate (checked above).
        && isRoute(b, 200)
        && b.amount == b.dayRate * b.days + b.extraCharge + b.returnCharge + b.ticket
        && b.at == request.time;
    }

    // The trip estimate the customer accepted in the app: the booking's own
    // estimate (trip.estTo, the top of the range they were shown), now.
    function isAcceptedPrice(a, b) {
      return a is map
        && a.keys().hasOnly(['amount', 'at'])
        && a.keys().hasAll(['amount', 'at'])
        && b.trip.estTo is int && b.trip.estTo > 0
        && a.amount is int && a.amount == b.trip.estTo
        && a.at == request.time;
    }

    // The driver has not tapped Start on this job yet (no tripTaps, or no leftAt).
    function notStarted(bookingId) {
      return !exists(/databases/$(database)/documents/tripTaps/$(bookingId))
        || !('leftAt' in get(/databases/$(database)/documents/tripTaps/$(bookingId)).data);
    }

    match /bookings/{bookingId} {
      // Admins see everything; a customer sees only bookings tied to their login;
      // a driver only the jobs assigned to him right now.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('customerUid', '') == request.auth.uid)
        || (isDriver() && isMyJob(resource.data));

      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'city', 'package', 'pickup',
          'preferredTime', 'notes', 'createdAt', 'status', 'source',
          'customerUid', 'trip', 'pickupGeo'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'city', 'package', 'pickup',
          'preferredTime', 'notes', 'createdAt', 'status', 'source'
        ])
        && isText(request.resource.data.name, 2, 60)
        && isMobile(request.resource.data.phone)
        && isServedCity(request.resource.data.city)
        && request.resource.data.package in [
          '1-hour-300',
          '3-hours-600',
          'local-full-day',
          'outstation',
          'night-driver',
          'medical-emergency',
          'monthly-basic',
          'monthly-premium',
          'wedding-event',
          'one-way-drop'
        ]
        && isText(request.resource.data.pickup, 6, 300)
        // The exact pickup spot, optional (GPS or a pin on the map; older forms leave it out).
        && (!('pickupGeo' in request.resource.data) || isGeo(request.resource.data.pickupGeo))
        && isOptionalText(request.resource.data.preferredTime, 40)
        && isOptionalText(request.resource.data.notes, 500)
        // Guests leave customerUid out; a logged-in customer can only tag their own uid.
        && (!('customerUid' in request.resource.data)
            || (isSignedIn() && request.resource.data.customerUid == request.auth.uid))
        // Only outstation trips and one-way drops carry a trip; it is optional
        // (older app versions leave it out).
        && (!('trip' in request.resource.data)
            || isTrip(request.resource.data.trip, request.resource.data.package))
        && !isBlocked(request.resource.data.phone)
        && isServerStamped(request.resource.data);

      // Admins move a booking through its lifecycle. The customer's own details
      // and everything the server wrote stay read-only, even to an admin.
      // Internal notes do NOT live here — the customer can read this document —
      // they go in the admin-only timeline below.
      allow update: if isAdmin()
        && changedOnly(['status', 'assignedDriver', 'cancelReason', 'quote', 'clock', 'bill', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in bookingStatuses()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['quote'])
            || request.resource.data.get('quote', null) == null
            || isQuote(request.resource.data.quote))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clock'])
            || request.resource.data.get('clock', null) == null
            || isClock(request.resource.data.clock))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bill'])
            || request.resource.data.get('bill', null) == null
            || isBill(request.resource.data.bill))
        && (request.resource.data.get('assignedDriver', null) == null
            || isDriverRef(request.resource.data.assignedDriver))
        && isOptionalText(request.resource.data.get('cancelReason', ''), 200)
        && isAdminStamped(request.resource.data);

      // A driver taking a job offer (offers/{bookingId}) in the Driver app: in the
      // same transaction the offer becomes "taken" by him. Only while it was open,
      // only for an Active driver in its city, only to himself.
      allow update: if isActiveDriver()
        && changedOnly(['status', 'assignedDriver', 'updatedAt', 'updatedBy'])
        && resource.data.status in ['new', 'confirmed']
        && request.resource.data.status == 'assigned'
        && request.resource.data.assignedDriver == meAsDriverRef()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && get(/databases/$(database)/documents/offers/$(bookingId)).data.status == 'open'
        && getAfter(/databases/$(database)/documents/offers/$(bookingId)).data.status == 'taken'
        && getAfter(/databases/$(database)/documents/offers/$(bookingId)).data.takenBy == meAsDriverRef();

      // The customer accepting the trip's estimate in the app ("Accept price"),
      // once, while the booking is still open: exactly the estimate they were
      // shown, at the server's time. The robot then confirms and offers it.
      allow update: if isSignedIn()
        && resource.data.get('customerUid', '') == request.auth.uid
        && resource.data.status in ['new', 'confirmed']
        && !('acceptedPrice' in resource.data)
        && changedOnly(['acceptedPrice'])
        && isAcceptedPrice(request.resource.data.acceptedPrice, resource.data);

      // "Can't make it": the driver who took the job gives it back before he
      // has tapped Start, in the same transaction as his offer becoming
      // "released". The robot offers it again (never to him) and counts a strike.
      allow update: if isDriver()
        && isMyJob(resource.data)
        && changedOnly(['status', 'assignedDriver', 'updatedAt', 'updatedBy'])
        && request.resource.data.status == 'confirmed'
        && request.resource.data.assignedDriver == null
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && notStarted(bookingId)
        && get(/databases/$(database)/documents/offers/$(bookingId)).data.status == 'taken'
        && get(/databases/$(database)/documents/offers/$(bookingId)).data.takenBy.phone == request.auth.token.driverPhone
        && getAfter(/databases/$(database)/documents/offers/$(bookingId)).data.status == 'released';

      allow delete: if false;

      // The timeline: one entry per change or note, append-only, admins only.
      // Status changes are written in the same batch as the change itself; so
      // is a quote or a final bill, whose entry keeps the driver's pay and the
      // profit.
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'from', 'to', 'note', 'by', 'at'])
          && request.resource.data.keys().hasAll(['type', 'from', 'to', 'note', 'by', 'at'])
          && request.resource.data.type in ['status', 'driver', 'note', 'quote', 'bill']
          && (request.resource.data.from == null || request.resource.data.from in bookingStatuses())
          && (request.resource.data.to == null || request.resource.data.to in bookingStatuses())
          && isOptionalText(request.resource.data.note, 500)
          && request.resource.data.by == request.auth.token.email
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    /* -------------------------------------------------------- trip links -- */
    //  The driver's trip clock (lib/tripclock.ts, the page /trip/?k=…). An
    //  admin makes one for an outstation trip or one-way drop and sends the
    //  link to the driver on WhatsApp. He needs no login: the document id IS
    //  the key (24–40 random letters and digits), so only someone who was sent
    //  the link can open or tap it, and nobody can list them. Each tap sets the
    //  next time to the server's clock, once and in order: start → drop (the
    //  car handed over; one-way only) → home. The alerts robot copies the times
    //  to the booking (clock) and tells Telegram; /admin works out the final
    //  bill and can correct a time.

    function isLoc(l) {
      return l is map
        && l.keys().hasOnly(['lat', 'lng', 'acc'])
        && l.keys().hasAll(['lat', 'lng', 'acc'])
        && l.lat is number && l.lat >= -90 && l.lat <= 90
        && l.lng is number && l.lng >= -180 && l.lng <= 180
        && l.acc is number && l.acc >= 0 && l.acc <= 100000;
    }

    // One tap for `step` ('start', 'drop' or 'home'): the server's time; the
    // phone's own clock (it may have been offline: at most a day earlier,
    // never more than 10 minutes ahead); where he was, if he allowed it.
    function isTap(step) {
      let d = request.resource.data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([step + 'At', step + 'Phone', step + 'Loc', 'updatedAt'])
        && d[step + 'At'] == request.time
        && d[step + 'Phone'] is timestamp
        && d[step + 'Phone'] > request.time - duration.value(24, 'h')
        && d[step + 'Phone'] < request.time + duration.value(10, 'm')
        && (!((step + 'Loc') in d) || isLoc(d[step + 'Loc']))
        && d.updatedAt == request.time;
    }

    function isDriverTap() {
      let o = resource.data;
      return o.closed == false
        && ((!('startAt' in o) && isTap('start'))
          || (o.kind == 'one-way' && ('startAt' in o) && !('dropAt' in o) && isTap('drop'))
          || (('startAt' in o) && (o.kind == 'round' || ('dropAt' in o)) && !('homeAt' in o) && isTap('home')));
    }

    function tripLinkKeys() {
      return ['bookingId', 'ref', 'to', 'kind', 'nonstop', 'driverName', 'closed', 'createdAt', 'updatedAt', 'by'];
    }

    match /tripLinks/{key} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isAdmin()
        && key.matches('^[A-Za-z0-9]{24,40}$')
        && request.resource.data.keys().hasOnly(tripLinkKeys())
        && request.resource.data.keys().hasAll(tripLinkKeys())
        && isText(request.resource.data.bookingId, 1, 128)
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && isOptionalText(request.resource.data.ref, 20)
        && isText(request.resource.data.to, 2, 60)
        && request.resource.data.kind in ['one-way', 'round']
        && request.resource.data.nonstop is bool
        && isText(request.resource.data.driverName, 2, 60)
        && request.resource.data.closed == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.by == request.auth.uid;

      // An admin correcting the times (a time is removed, never set to
      // null), switching day-and-night driving, or closing the link once the
      // bill is saved; or the driver's tap.
      allow update: if (isAdmin()
          && changedOnly(['startAt', 'dropAt', 'homeAt', 'nonstop', 'closed', 'updatedAt', 'by'])
          && isOptTime(request.resource.data, 'startAt')
          && isOptTime(request.resource.data, 'dropAt')
          && isOptTime(request.resource.data, 'homeAt')
          && (request.resource.data.kind == 'one-way' || !('dropAt' in request.resource.data))
          && inOrder(request.resource.data, 'startAt', 'dropAt')
          && inOrder(request.resource.data, 'dropAt', 'homeAt')
          && inOrder(request.resource.data, 'startAt', 'homeAt')
          && request.resource.data.nonstop is bool
          && request.resource.data.closed is bool
          && request.resource.data.updatedAt == request.time
          && request.resource.data.by == request.auth.uid)
        || isDriverTap();

      allow delete: if false;
    }

    /* ---------------------------------------------------------- trip taps -- */
    //  The Driver app's buttons on his job: Start (on my way) → Arrived → Job
    //  done → (one-way drops) Reached home. Only the driver the booking is
    //  assigned to, while it is "assigned"; each time once, in that order, at
    //  the server's time. The alerts robot copies them to the booking (a trip's
    //  clock, a local job's bill) — the customer sees them there, not here.

    function tapIs(next, before) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([next])
        && (before in resource.data)
        && !(next in resource.data)
        && request.resource.data[next] == request.time;
    }

    match /tripTaps/{bookingId} {
      function job() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }

      allow read: if isAdmin()
        || (isDriver() && (isMyJob(job()) || resource.data.driverPhone == request.auth.token.driverPhone));

      // Start: the document begins with his number and the time he left.
      allow create: if isDriver() && isMyJob(job())
        && request.resource.data.keys().hasOnly(['driverPhone', 'leftAt'])
        && request.resource.data.keys().hasAll(['driverPhone', 'leftAt'])
        && request.resource.data.driverPhone == request.auth.token.driverPhone
        && request.resource.data.leftAt == request.time;

      allow update: if isDriver() && isMyJob(job())
        && resource.data.driverPhone == request.auth.token.driverPhone
        && (tapIs('arrivedAt', 'leftAt')
          || tapIs('doneAt', 'arrivedAt')
          || (tapIs('homeAt', 'doneAt') && job().package == 'one-way-drop'));

      allow delete: if false;
    }

    /* ----------------------------------------------------------- drivers -- */
    //  Applications from components/DriverForm.tsx; vetted in /admin.
    //  ratingAvg, ratingCount and strikes are the alerts robot's (no browser
    //  can write them).

    match /drivers/{driverId} {
      // Admins see all; a driver logged in to the Driver app sees his own (city, name).
      allow read: if isAdmin() || (isDriver() && request.auth.token.get('driverId', '') == driverId);

      // An admin adding a driver he has already met and checked ("+ Add driver"
      // in /admin, lib/admin.ts addDriver): straight in as Verified or Active.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'city', 'experienceYears', 'licence', 'about',
          'adminNote', 'createdAt', 'status', 'source', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'city', 'experienceYears', 'licence', 'about',
          'adminNote', 'createdAt', 'status', 'source', 'updatedAt', 'updatedBy'
        ])
        && isText(request.resource.data.name, 2, 60)
        && isMobile(request.resource.data.phone)
        && isServedCity(request.resource.data.city)
        && request.resource.data.experienceYears is int
        && request.resource.data.experienceYears >= 5
        && request.resource.data.experienceYears <= 60
        && request.resource.data.licence in ['commercial', 'lmv', 'both']
        && isOptionalText(request.resource.data.about, 500)
        && isOptionalText(request.resource.data.adminNote, 1000)
        && request.resource.data.status in ['verified', 'active']
        && request.resource.data.source == 'admin'
        && request.resource.data.createdAt == request.time
        && isAdminStamped(request.resource.data);

      // An application from the website or the app's form.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'city', 'experienceYears',
          'licence', 'about', 'createdAt', 'status', 'source'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'city', 'experienceYears',
          'licence', 'about', 'createdAt', 'status', 'source'
        ])
        && isText(request.resource.data.name, 2, 60)
        && isMobile(request.resource.data.phone)
        && isServedCity(request.resource.data.city)
        && request.resource.data.experienceYears is int
        && request.resource.data.experienceYears >= 5
        && request.resource.data.experienceYears <= 60
        && request.resource.data.licence in ['commercial', 'lmv', 'both']
        && isOptionalText(request.resource.data.about, 500)
        && !isBlocked(request.resource.data.phone)
        && isServerStamped(request.resource.data);

      // new → verified → active ⇄ inactive, or rejected.
      allow update: if isAdmin()
        && changedOnly(['status', 'adminNote', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'verified', 'active', 'inactive', 'rejected']
        && isOptionalText(request.resource.data.get('adminNote', ''), 1000)
        && isAdminStamped(request.resource.data);

      // The driver himself, in the Driver app (Earnings): his UPI ID, where the
      // weekly payout goes. Nothing else on his record.
      allow update: if isDriver()
        && request.auth.token.get('driverId', '') == driverId
        && resource.data.phone == request.auth.token.driverPhone
        && changedOnly(['upi', 'updatedAt'])
        && request.resource.data.upi is string
        && request.resource.data.upi.matches('^[a-zA-Z0-9.\\-_]{2,64}@[a-zA-Z]{2,32}$')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time);

      allow delete: if false;
    }

    /* ---------------------------------------------------------- tracking -- */
    //  Live tracking: one document per booking, written by the Driver app every
    //  few seconds between Start and Arrived (active false), only by the driver
    //  the booking is assigned to and only while it is "assigned". The customer
    //  who booked while logged in sees it on a map in the DriveBuddy app.

    function isTrack(d) {
      return d.keys().hasOnly(['lat', 'lng', 'acc', 'heading', 'speed', 'active', 'at', 'phoneAt', 'driverPhone', 'driverName'])
        && d.keys().hasAll(['lat', 'lng', 'acc', 'active', 'at', 'phoneAt', 'driverPhone'])
        && d.lat is number && d.lat >= 6 && d.lat <= 37
        && d.lng is number && d.lng >= 68 && d.lng <= 98
        && d.acc is number && d.acc >= 0 && d.acc <= 100000
        && (!('heading' in d) || (d.heading is number && d.heading >= -1 && d.heading <= 360))
        && (!('speed' in d) || (d.speed is number && d.speed >= -1 && d.speed <= 100))
        && d.active is bool
        && d.at == request.time
        && d.phoneAt is timestamp
        && d.phoneAt > request.time - duration.value(24, 'h')
        && d.phoneAt < request.time + duration.value(10, 'm')
        && d.driverPhone == request.auth.token.driverPhone
        && (!('driverName' in d) || isText(d.driverName, 2, 60));
    }

    match /tracking/{bookingId} {
      function job() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }

      allow read: if isAdmin()
        || (isSignedIn() && job().get('customerUid', '') == request.auth.uid)
        || (isDriver() && isMyJob(job()));
      allow create, update: if isDriver() && isMyJob(job()) && isTrack(request.resource.data);
      allow delete: if false;
    }

    /* ------------------------------------------------------ availability -- */
    //  "Online" in the Driver app: while it is on, the app writes where the
    //  driver is about every 2 minutes, with the phone's push token, so the
    //  alerts robot can send a new job offer to the nearest online drivers
    //  first. Only an Active driver, only his own document, only his city.
    //  Admins see who is online. Offline = online false (the spot is dropped).

    match /availability/{driverId} {
      allow read: if isAdmin() || (isDriver() && request.auth.token.get('driverId', '') == driverId);
      allow create, update: if isActiveDriver()
        && request.auth.token.driverId == driverId
        && request.resource.data.keys().hasOnly(['online', 'city', 'name', 'phone', 'lat', 'lng', 'acc', 'pushToken', 'at'])
        && request.resource.data.keys().hasAll(['online', 'city', 'name', 'phone', 'at'])
        && request.resource.data.online is bool
        && request.resource.data.city == myDriver().city
        && request.resource.data.name == myDriver().name
        && request.resource.data.phone == request.auth.token.driverPhone
        && request.resource.data.at == request.time
        && (!('lat' in request.resource.data) || (request.resource.data.lat is number && request.resource.data.lat >= 6 && request.resource.data.lat <= 37))
        && (!('lng' in request.resource.data) || (request.resource.data.lng is number && request.resource.data.lng >= 68 && request.resource.data.lng <= 98))
        && (!('acc' in request.resource.data) || (request.resource.data.acc is number && request.resource.data.acc >= 0 && request.resource.data.acc <= 100000))
        && (!('pushToken' in request.resource.data) || isOptionalText(request.resource.data.pushToken, 200));
      allow delete: if false;
    }

    /* ------------------------------------------------------------ offers -- */
    //  Job offers: an admin offers a booking to the drivers of its city, with what
    //  the driver earns (the price minus DriveBuddy's cut, 20–30%). Active drivers
    //  of that city see open offers in the Driver app — no customer name, number
    //  or address, only the area — and the first to tap Accept takes it (the
    //  booking is assigned to him in the same transaction, see bookings). He then
    //  sees his taken offers as his earnings: what DriveBuddy owes him, and what
    //  it has paid. The customer never sees this document (the cut is private).
    //  `cities`: where it is offered — its own city, and (the alerts robot, when
    //  nobody takes it) the nearby ones. Older offers have no `cities`: their
    //  city only. He may give a taken job back before Start ("released"); the
    //  robot offers it again.

    function offerKeys() {
      return ['bookingId', 'ref', 'city', 'package', 'when', 'area', 'to', 'price', 'cutPercent', 'driverPay',
              'status', 'takenBy', 'takenAt', 'done', 'paid', 'paidAt', 'createdAt', 'updatedAt', 'by'];
    }

    function isOfferShape(o, bookingId) {
      return o.keys().hasOnly(offerKeys().concat(['cities'])) && o.keys().hasAll(offerKeys())
        && o.bookingId == bookingId
        && isOptionalText(o.ref, 20)
        && isServedCity(o.city)
        && isText(o.package, 1, 40)
        && isOptionalText(o.when, 40)
        && isText(o.area, 2, 120)
        && isOptionalText(o.to, 60)
        && o.price is int && o.price >= 100 && o.price <= 500000
        && o.cutPercent is int && o.cutPercent >= 20 && o.cutPercent <= 30
        && o.driverPay is int && o.driverPay > 0 && o.driverPay < o.price
        && o.status in ['open', 'taken', 'withdrawn', 'released']
        && (!('cities' in o) || isOfferCities(o))
        && (o.takenBy == null || isDriverRef(o.takenBy))
        && (o.takenAt == null || o.takenAt is timestamp)
        && o.done is bool && o.paid is bool
        && (o.paidAt == null || o.paidAt is timestamp)
        && o.createdAt is timestamp && o.updatedAt == request.time;
    }

    // Served cities, its own city among them, each once at most (4 cities).
    function isOfferCities(o) {
      return o.cities is list
        && o.cities.size() >= 1 && o.cities.size() <= 4
        && o.cities.hasOnly(['Raipur', 'Bhilai', 'Durg', 'Bilaspur'])
        && o.city in o.cities;
    }

    // Offered to this driver's city: in `cities` (the Driver app asks with
    // array-contains), or — older offers without `cities` — its city.
    function offeredToMe(o) {
      return (myDriver().city in o.cities) || o.city == myDriver().city;
    }

    match /offers/{bookingId} {
      allow read: if isAdmin()
        || (isActiveDriver() && resource.data.status == 'open' && offeredToMe(resource.data))
        || (isDriver() && resource.data.takenBy.phone == request.auth.token.driverPhone);

      // An admin posts an offer (open, nobody yet) for a booking that exists.
      allow create: if isAdmin()
        && isOfferShape(request.resource.data, bookingId)
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && request.resource.data.status == 'open'
        && request.resource.data.takenBy == null && request.resource.data.takenAt == null
        && request.resource.data.done == false && request.resource.data.paid == false
        && request.resource.data.paidAt == null
        && (!('cities' in request.resource.data) || request.resource.data.cities == [request.resource.data.city])
        && request.resource.data.createdAt == request.time
        && request.resource.data.by == request.auth.uid;

      // An admin changes it: the price or cut while it is open, withdraws it,
      // offers it again, marks the job done or the driver paid.
      allow update: if isAdmin()
        && isOfferShape(request.resource.data, bookingId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.by == request.auth.uid;

      // A driver accepts an open offer in his city: it becomes his, now, and the
      // booking is assigned to him in the same transaction.
      allow update: if isActiveDriver()
        && resource.data.status == 'open'
        && offeredToMe(resource.data)
        && changedOnly(['status', 'takenBy', 'takenAt', 'updatedAt'])
        && request.resource.data.status == 'taken'
        && request.resource.data.takenBy == meAsDriverRef()
        && request.resource.data.takenAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriver == meAsDriverRef();

      // "Can't make it": the driver who took it gives it back — not done yet,
      // before he tapped Start — and the booking goes back to "confirmed" with
      // no driver in the same transaction.
      allow update: if isDriver()
        && resource.data.status == 'taken'
        && resource.data.takenBy.phone == request.auth.token.driverPhone
        && resource.data.done == false
        && changedOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'released'
        && request.resource.data.updatedAt == request.time
        && notStarted(bookingId)
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'confirmed'
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.assignedDriver == null;

      allow delete: if false;
    }

    /* ----------------------------------------------------------- ratings -- */
    //  ratings/{bookingId}: the customer rates the driver once the job is
    //  completed (the DriveBuddy app). Once, never changed or deleted. The
    //  alerts robot works out drivers/{id}.ratingAvg and ratingCount from them.
    //  The customer can see their own rating (so the app knows it was sent).

    match /ratings/{bookingId} {
      function job() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if isSignedIn()
        && job().get('customerUid', '') == request.auth.uid
        && job().status == 'completed'
        && job().assignedDriver != null
        && request.resource.data.keys().hasOnly(['stars', 'comment', 'driverId', 'customerUid', 'at'])
        && request.resource.data.keys().hasAll(['stars', 'comment', 'driverId', 'customerUid', 'at'])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && isOptionalText(request.resource.data.comment, 300)
        && request.resource.data.driverId == job().assignedDriver.id
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    /* ------------------------------------------------------------- users -- */
    //  A customer's own login profile, written from /account.

    match /users/{uid} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == uid;
      }
      function validProfile(data) {
        return isText(data.name, 2, 60)
          && (data.get('phone', '') == '' || isMobile(data.get('phone', '')))
          && (data.get('email', '') == '' || data.get('email', '') == request.auth.token.get('email', ''));
      }

      allow read: if isOwner() || isAdmin();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && changedOnly(['name', 'phone', 'email', 'updatedAt'])
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // "Delete my account" in the app (a Google Play and App Store requirement).
      // Their bookings stay, as business records (see /privacy).
      allow delete: if isOwner();

      // One per phone with booking notifications on, written by the mobile app:
      // the Expo push token and the language to write in. The alerts robot
      // reads these to send "Driver assigned" and other status updates. The
      // customer removes their phone on logout; the robot drops dead tokens.
      match /devices/{deviceId} {
        function validDevice(data) {
          return data.keys().hasOnly(['token', 'platform', 'language', 'updatedAt'])
            && data.keys().hasAll(['token', 'platform', 'language', 'updatedAt'])
            && data.token is string
            && data.token.matches('^Expo(nent)?PushToken\\[[A-Za-z0-9_-]{8,200}\\]$')
            && data.platform in ['android', 'ios']
            && data.language in ['en', 'hi']
            && data.updatedAt == request.time;
        }
        allow read, delete: if isOwner();
        allow create, update: if isOwner() && deviceId.size() <= 150 && validDevice(request.resource.data);
      }
    }

    /* --------------------------------------------------------- customers -- */
    //  One record per phone number, kept by the alerts robot: name, booking
    //  count, first and last booking. Read-only, admins only.

    match /customers/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ----------------------------------------------------------- blocked -- */
    //  blocked/{phone}: numbers that may not book or apply (spam, abuse).
    //  Added and removed by an admin from a booking in /admin. Never readable
    //  by customers, so a blocked number cannot tell why.

    match /blocked/{phone} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isMobile(phone)
        && request.resource.data.keys().hasOnly(['reason', 'by', 'at'])
        && request.resource.data.keys().hasAll(['reason', 'by', 'at'])
        && isOptionalText(request.resource.data.reason, 200)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    /* ------------------------------------------------------------ admins -- */
    //  admins/{email}: written by the alerts robot's setup() or by hand in the
    //  Firebase console. A signed-in user may check only their own entry —
    //  that is how /admin knows whether to show the dispatch desk.

    match /admins/{email} {
      allow read: if isSignedIn() && request.auth.token.get('email', '').lower() == email;
      allow write: if false;
    }

    /* -------------------------------------------------------- catch-all -- */
    //  Anything not allowed above is denied — including meta/counters, the
    //  alerts robot's own notes (offerAlerts/, reminders/) and any collection
    //  someone invents.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
