{
  "name": "drivebuddy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && node scripts/check-prices.mjs",
    "og": "node scripts/og.mjs",
    "leads": "node scripts/export-leads.mjs",
    "inbox": "node scripts/inbox.mjs",
    "audit": "node scripts/audit.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "node --test \"scripts/*.test.mjs\" \"functions/test/*.test.js\"",
    "check": "npm run lint && next build && node scripts/audit.mjs",
    "setup:alerts": "node scripts/setup-alerts.mjs",
    "deploy:backend": "npm --prefix functions install && npx --yes firebase-tools@15 deploy --only firestore,functions",
    "test:rules": "npm --prefix tests/rules install && npm --prefix tests/rules test"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.4",
    "exceljs": "^4.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
