# env files — .env.local holds the Firebase project pointers.
# They are public identifiers rather than secrets, but keeping them out of git
# means staging and production can differ without a code change.
.env*.local
.env

# typescript
*.tsbuildinfo

# firebase tooling
.firebase/
firebase-debug.log*
firestore-debug.log*

# editors
.vscode/*
!.vscode/extensions.json
.idea/
