# DriveBuddy — Firebase configuration used by the production build.
#
# This file IS committed to the repository, on purpose. Firebase web config is a
# set of PUBLIC IDENTIFIERS: they are compiled into the browser bundle, so anyone
# who visits the site can read them from view-source either way. Hiding them in
# CI variables would protect nothing and would mean re-entering six values by
# hand on every host.
#
# What actually protects your customers' data is firestore.rules — deploy it:
#     npx firebase-tools deploy --only firestore:rules
#
# .env.local (not committed) overrides this file during local development, so you
# can point `npm run dev` at a separate test project without touching this one.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCIGiv764yafx3HsmmbwpQuolKQcm64Ulo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=drive-buddy-acc4c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=drive-buddy-acc4c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=drive-buddy-acc4c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=56159522240
NEXT_PUBLIC_FIREBASE_APP_ID=1:56159522240:web:d8454bea63494f064dcc25
